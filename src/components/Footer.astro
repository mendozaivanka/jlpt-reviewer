---
import { nav, site } from "@/data/site";
const year = new Date().getFullYear();
---

<footer class="mt-18 border-t border-border print:hidden">
  <div
    class="container-site flex flex-col items-start justify-between gap-3 pt-6 pb-[max(2rem,env(safe-area-inset-bottom,0px))] sm:flex-row sm:items-center"
  >
    <nav class="flex flex-wrap gap-x-4 gap-y-1" aria-label="Footer">
      {nav.map((l) => <a href={l.href} class="py-1 text-sm text-muted-foreground transition-colors hover:text-foreground">{l.label}</a>)}
    </nav>
    <small class="text-[13px] text-muted-foreground">© {year} {site.name} · set in Nordic Rose · <a href={import.meta.env.BASE_URL + "about/"} class="underline-offset-4 hover:underline">sources and licenses</a></small>
  </div>
</footer>
