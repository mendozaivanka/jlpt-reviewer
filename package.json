{
  "name": "jlpt-reviewer",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "tokens": "node scripts/gen-tokens.ts",
    "predev": "npm run tokens",
    "dev": "astro dev",
    "prebuild": "npm run tokens",
    "build": "astro check && astro build",
    "data": "node --max-old-space-size=4096 scripts/build-data.mjs",
    "data:refresh": "node --max-old-space-size=4096 scripts/build-data.mjs --refresh",
    "deploy": "npm run data && npm run build && node scripts/deploy.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "design:sync": "node scripts/sync-nordic-rose.mjs",
    "design:check": "node scripts/sync-nordic-rose.mjs --check",
    "design:verify": "node scripts/sync-nordic-rose.mjs --verify"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.0",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/red-hat-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "dexie": "^4.4.7",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "ts-fsrs": "^6.0.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "fflate": "^0.8.3",
    "typescript": "^6.0.3"
  },
  "description": "JLPT N4 to N3 review course in the Sou Matome rhythm, built on open dictionary data",
  "license": "MIT"
}
